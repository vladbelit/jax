# Keep successful DNS lookups long enough to bridge brief resolver outages.
# Also allow Bazel's remote retries to retry failed lookups after one
# second instead of using the JVM's default ten-second negative cache.
networkaddress.cache.ttl=60
networkaddress.cache.negative.ttl=1
